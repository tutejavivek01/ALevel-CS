# Copy to .env.local and fill in from your Supabase project's dashboard
# (Project Settings -> API for the first three, Project Settings ->
# Database -> Connection string -> Session pooler for the last one).
#
# Use the Session pooler connection string, not "Direct connection" --
# the direct host is IPv6-only and won't resolve on IPv4-only networks.
# The pooler also requires SSL; see scripts/migrate.mjs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Exam question bank AI marking (specs/exam-question-bank/design.md §3,
# §7) - server-only, read exclusively by app/api/exam-questions/mark/
# route.ts. Never exposed to the client. Get a key from
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
# Set to 'true' (e.g. in a local/test .env.local only) to use a
# deterministic stub marker instead of a real API call - lets the full
# submit/persist/mark/display flow run without a real key or its cost.
# Leave unset in production.
EXAM_MARKING_STUB=
